# Переменные окружения для продакшн-деплоя (Render / Railway / VPS).
# Скопировать в панель хостинга; в git этот файл не нужен — он только шаблон.

# Managed PostgreSQL: у Render/Railway строка приходит из панели базы.
# sslmode=require обязателен для внешних managed-баз (Neon, Supabase, Render).
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public&sslmode=require"

# Порт, который слушает приложение. Хостинг может переопределить своим PORT.
PORT=3000

NODE_ENV=production
