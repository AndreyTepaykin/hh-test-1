{
  "name": "digital-card",
  "version": "1.0.0",
  "private": true,
  "description": "GraphQL digital business card for Andrey Tepaykin",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nest build",
    "prestart": "npm run prestart:dev",
    "prestart:dev": "npm run db:generate && npm run db:migrate && npm run db:seed",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reseed": "tsx prisma/seed.ts --force",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^13.1.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^11.1.0",
    "@nestjs/graphql": "^13.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@prisma/client": "^6.16.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dataloader": "^2.2.3",
    "graphql": "^16.11.0",
    "prisma": "^6.16.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsx": "^4.20.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.2"
  }
}
