generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id          String  @id @default(cuid())
  name        String
  description String
  links       ProfileLink[]
  skills      Skill[]
  experiences Experience[]
  projects    Project[]
}

model ProfileLink {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  label     String
  url       String
  sortOrder Int

  @@index([profileId])
}

model Skill {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int

  @@index([profileId])
}

model Experience {
  id           String        @id @default(cuid())
  profileId    String
  profile      Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  company      String
  position     String
  startDate    DateTime      @db.Date
  endDate      DateTime?     @db.Date
  companyUrl   String?
  sortOrder    Int
  achievements Achievement[]

  @@index([profileId])
}

model Achievement {
  id           String     @id @default(cuid())
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  text         String
  sortOrder    Int

  @@index([experienceId])
}

model Project {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name      String
  url       String
  sortOrder Int

  @@index([profileId])
}
